# ─────────────────────────────────────────────
# CrisisLink Backend Environment Configuration
# ─────────────────────────────────────────────

# Arduino serial port
# Windows examples: COM3, COM4, COM5
# Linux examples:   /dev/ttyUSB0, /dev/ttyACM0
# macOS examples:   /dev/cu.usbmodem..., /dev/cu.usbserial...
# Leave blank to let the backend auto-detect the Arduino port.
ARDUINO_PORT=

# Backend HTTP + WebSocket server port
BACKEND_PORT=3001
